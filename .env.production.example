POSTGRES_DB=recsys
POSTGRES_USER=recsys_app
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql+psycopg://recsys_app:replace-with-a-url-encoded-database-password@db:5432/recsys
